{
  "name": "schedulebot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "worker": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:worker": "wrangler deploy",
    "telegram:setup": "node scripts/telegram.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261127.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
